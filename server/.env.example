# Environment variables for the Twin Care Hospital API server
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git — it contains secrets.

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Your MongoDB Atlas connection string.
# Find it in Atlas → your cluster → Connect → Drivers → copy the URI.
# Replace <username>, <password>, and <dbname> with your actual values.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/twincare?appName=Cluster0

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on. 5000 is the local dev default.
PORT=5000

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of the React frontend. Change this to the deployed URL in production.
CLIENT_URL=http://localhost:5173

# ── Email (optional) ─────────────────────────────────────────────────────────
# If these are left blank, contact form submissions are still saved to MongoDB
# but no email notification is sent. Fill these in when the hospital is ready
# to receive email alerts.
HOSPITAL_INBOX_EMAIL=dainsenju@gmail.com
SMTP_EMAIL=your-gmail@gmail.com
# For Gmail: use an App Password (not your regular password).
# Google account → Security → 2-Step Verification → App Passwords
SMTP_PASSWORD=your-app-password-here

# ── Admin auth ────────────────────────────────────────────────────────────────
# After setting the three values below, run `node seed-admin.js` once (from the
# server/ directory) to create the admin account. Safe to re-run to reset creds.

# A long, random secret string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=a-long-random-string-change-this-before-deploying

# Credentials for the single admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-going-live

# Set to 'production' on the deployed server (Render, etc.) to enable
# secure HTTPS-only cookies and correct sameSite=none cross-domain behaviour.
# Leave as 'development' (or unset) for local dev.
NODE_ENV=development
